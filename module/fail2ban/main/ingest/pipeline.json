{
  "description": "Pipeline for parsing Fail2Ban logs",
  "processors": [
    {
      "grok": {
        "field": "message",
        "patterns": [
          "%{FAIL2BAN_LINE}"
        ],
        "pattern_definitions": {
          "FAIL2BAN_LINE": "%{FAIL2BAN_LINE_BEGIN} (%{FAIL2BAN_FOUND}$|%{FAIL2BAN_INCREASE}$|%{FAIL2BAN_BAN}$|%{FAIL2BAN_REBAN}$|%{FAIL2BAN_UNBAN}$|%{FAIL2BAN_ALREADY_BANNED}$|%{FAIL2BAN_IGNORE}$|%{FAIL2BAN_MESSAGE})",

          "FAIL2BAN_LINE_BEGIN": "^%{FAIL2BAN_DATETIME:fail2ban.datetime} %{FAIL2BAN_MODULE:fail2ban.module}%{SPACE}\\[%{INT:fail2ban.pid}\\]:%{SPACE}%{FAIL2BAN_LOG_LEVEL}%{SPACE}",

          "FAIL2BAN_DATETIME": "%{YEAR}-%{MONTHNUM}-%{MONTHDAY} %{HOUR}:%{MINUTE}:%{SECOND},%{INT}",
          "FAIL2BAN_MODULE": "fail2ban\\.[a-zA-Z]+",
          "FAIL2BAN_LOG_LEVEL": "%{LOGLEVEL:fail2ban.log_level}",

          "FAIL2BAN_BAN": "%{FAIL2BAN_JAIL} %{FAIL2BAN_ACTION:fail2ban.action} %{IP:fail2ban.ip}",
          "FAIL2BAN_REBAN": "%{FAIL2BAN_JAIL} %{FAIL2BAN_ACTION:fail2ban.action} %{IP:fail2ban.ip}.+",
          "FAIL2BAN_FOUND": "%{FAIL2BAN_JAIL} %{FAIL2BAN_ACTION:fail2ban.action} %{IP:fail2ban.ip} - %{TIMESTAMP_ISO8601:fail2ban.event_timestamp}",
          "FAIL2BAN_IGNORE": "%{FAIL2BAN_JAIL} %{FAIL2BAN_ACTION:fail2ban.action} %{IP:fail2ban.ip} by ip",
          "FAIL2BAN_INCREASE": "%{FAIL2BAN_JAIL} %{FAIL2BAN_ACTION:fail2ban.action} %{IP:fail2ban.ip} \\(%{FAIL2BAN_INCREASE_DETAILS}\\)",
          "FAIL2BAN_UNBAN": "%{FAIL2BAN_JAIL} %{FAIL2BAN_ACTION:fail2ban.action} %{IP:fail2ban.ip}",
          "FAIL2BAN_ALREADY_BANNED": "%{FAIL2BAN_JAIL} %{IP:fail2ban.ip} %{FAIL2BAN_ACTION:fail2ban.action}",

          "FAIL2BAN_ACTION": "[a-zA-Z ]+",

          "FAIL2BAN_JAIL": "\\[%{FAIL2BAN_JAIL_NAME:fail2ban.jail}\\]",
          "FAIL2BAN_JAIL_NAME": "[a-z\\-_]+",

          "FAIL2BAN_INCREASE_DETAILS": "%{INT:fail2ban.count} # %{DATA:fail2ban.duration} -> %{TIMESTAMP_ISO8601:fail2ban.expiry}",

          "FAIL2BAN_MESSAGE": "(%{FAIL2BAN_THREADID:fail2ban.threadid} -- )?%{GREEDYDATA:fail2ban.message}",
          "FAIL2BAN_THREADID": "[a-z0-9]+"
        }
      }
    },
    {
      "rename": {
        "field": "message",
        "target_field": "fail2ban.message_raw"
      }
    },
    {
      "set": {
        "field": "fail2ban.timezone",
        "value": "UTC",
        "override": false
      }
    },
    {
      "date": {
        "field": "fail2ban.datetime",
        "target_field": "@timestamp",
        "timezone": "{{ fail2ban.timezone }}",
        "formats": [
          "uuuu-MM-dd HH:mm:ss,SSS"
        ]
      }
    },
    {
      "remove": {
        "field": "fail2ban.datetime"
      }
    },
    {
      "remove": {
        "field": "fail2ban.timezone"
      }
    },
    {
      "convert": {
        "field": "fail2ban.pid",
        "type": "integer"
      }
    },
    {
      "convert": {
        "field": "fail2ban.count",
        "type": "integer",
        "ignore_missing": true
      }
    },
    {
      "lowercase": {
        "field": "fail2ban.action",
        "ignore_missing": true
      }
    }
  ],
  "on_failure" : [{
    "set" : {
      "field" : "error.message",
      "value" : "{{ _ingest.on_failure_message }}"
    }
  }]
}
