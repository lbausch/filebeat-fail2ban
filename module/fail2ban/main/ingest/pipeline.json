{
  "description": "Pipeline for parsing Fail2Ban logs",
  "processors": [
    {
      "grok": {
        "field": "message",
        "patterns": [
          "%{FAIL2BAN_FOUND}",
          "%{FAIL2BAN_IGNORE}",
          "%{FAIL2BAN_BAN}",
          "%{FAIL2BAN_INCREASE}",
          "%{FAIL2BAN_UNBAN}"
        ],
        "pattern_definitions": {
          "FAIL2BAN_FOUND": "^%{FAIL2BAN_LINE_BEGIN}Found %{IP:fail2ban.ip}%{SPACE}-%{SPACE}%{TIMESTAMP_ISO8601:fail2ban.event_timestamp}",
          "FAIL2BAN_IGNORE": "^%{FAIL2BAN_LINE_BEGIN}Ignore %{IP:fail2ban.ip} by ip",
          "FAIL2BAN_BAN": "^%{FAIL2BAN_LINE_BEGIN}Ban %{IP:fail2ban.ip}",
          "FAIL2BAN_INCREASE": "^%{FAIL2BAN_LINE_BEGIN}Increase Ban %{IP:fail2ban.ip} \\(%{FAIL2BAN_INCREASE_DETAILS}\\)",
          "FAIL2BAN_UNBAN": "^%{FAIL2BAN_LINE_BEGIN} Unban %{IP:fail2ban.ip}",

          "FAIL2BAN_LINE_BEGIN": "%{FAIL2BAN_DATETIME:fail2ban.datetime} %{FAIL2BAN_MODULE:fail2ban.module}%{SPACE}\\[%{INT:fail2ban.pid}\\]:%{SPACE}%{FAIL2BAN_LOG_LEVEL:fail2ban.log_level}%{SPACE}\\[%{FAIL2BAN_JAIL:fail2ban.jail}\\]%{SPACE}",

          "FAIL2BAN_DATETIME": "%{YEAR}-%{MONTHNUM}-%{MONTHDAY} %{HOUR}:%{MINUTE}:%{SECOND},%{INT}",

          "FAIL2BAN_MODULE": "fail2ban\\.[a-z]+",

          "FAIL2BAN_LOG_LEVEL": "%{LOGLEVEL}",

          "FAIL2BAN_JAIL": "[a-z\\-_]+",

          "FAIL2BAN_INCREASE_DETAILS": "%{INT:fail2ban.count} # %{DATA:fail2ban.duration} -> %{TIMESTAMP_ISO8601:fail2ban.expiry}"
        }
      }
    },
    {
      "rename": {
        "field": "message",
        "target_field": "fail2ban.message_raw"
      }
    },
    {
      "set": {
        "field": "fail2ban.timezone",
        "value": "UTC",
        "override": false
      }
    },
    {
      "date": {
        "field": "fail2ban.datetime",
        "target_field": "@timestamp",
        "timezone": "{{ fail2ban.timezone }}",
        "formats": [
          "uuuu-MM-dd HH:mm:ss,SSS"
        ]
      }
    },
    {
      "remove": {
        "field": "fail2ban.datetime"
      }
    },
    {
      "remove": {
        "field": "fail2ban.timezone"
      }
    },
    {
      "convert": {
        "field": "fail2ban.pid",
        "type": "integer"
      }
    },
    {
      "convert": {
        "field": "fail2ban.count",
        "type": "integer",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "field": "fail2ban.message",
        "value": "found",
        "if": "ctx.fail2ban.message_raw.contains('] Found ')"
      }
    },
    {
      "set": {
        "field": "fail2ban.message",
        "value": "ignore",
        "if": "ctx.fail2ban.message_raw.contains('] Ignore ')"
      }
    },
    {
      "set": {
        "field": "fail2ban.message",
        "value": "ban",
        "if": "ctx.fail2ban.message_raw.contains('] Ban ')"
      }
    },
    {
      "set": {
        "field": "fail2ban.message",
        "value": "increase_ban",
        "if": "ctx.fail2ban.message_raw.contains('] Increase ')"
      }
    },
    {
      "set": {
        "field": "fail2ban.message",
        "value": "unban",
        "if": "ctx.fail2ban.message_raw.contains('] Unban ')"
      }
    }
  ],
  "on_failure" : [{
    "set" : {
      "field" : "error.message",
      "value" : "{{ _ingest.on_failure_message }}"
    }
  }]
}
